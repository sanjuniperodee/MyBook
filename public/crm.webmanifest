{
  "id": "/admin",
  "name": "MyBooks CRM",
  "short_name": "MyBooks CRM",
  "description": "Сделки, чаты, заказы и задачи MyBooks",
  "start_url": "/admin?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f7f4ef",
  "theme_color": "#7a1f2b",
  "lang": "ru",
  "icons": [
    { "src": "/crm-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/crm-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/crm-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Чаты", "url": "/admin/chats", "icons": [{ "src": "/crm-icon-192.png", "sizes": "192x192" }] },
    { "name": "Задачи", "url": "/admin/tasks", "icons": [{ "src": "/crm-icon-192.png", "sizes": "192x192" }] },
    { "name": "Заказы", "url": "/admin/board", "icons": [{ "src": "/crm-icon-192.png", "sizes": "192x192" }] }
  ]
}
