{
  "openapi": "3.1.0",
  "info": {
    "title": "MyBooks API",
    "version": "1",
    "description": "Единственный путь к данным для веба и мобильного приложения (ADR 0012). Вход — Authorization: Bearer <token> или cookie mb_session."
  },
  "servers": [
    {
      "url": "https://mybooks.kz"
    }
  ],
  "security": [
    {
      "bearer": []
    },
    {
      "cookie": []
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "authLogin",
        "tags": [
          "auth"
        ],
        "summary": "Вход по почте или телефону и паролю (клиент и сотрудник)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "none"
      }
    },
    "/api/v1/auth/2fa": {
      "post": {
        "operationId": "authSecondFactor",
        "tags": [
          "auth"
        ],
        "summary": "Второй шаг входа сотрудника: код из приложения-аутентификатора",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SecondFactorBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "none"
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "authLogout",
        "tags": [
          "auth"
        ],
        "summary": "Выход: сессия токена закрывается",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "user"
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me",
        "tags": [
          "auth"
        ],
        "summary": "Кто вошёл",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "user"
      }
    },
    "/api/v1/themes": {
      "get": {
        "operationId": "themesList",
        "tags": [
          "books"
        ],
        "summary": "Виды книг для мастера создания (язык — ?locale=ru|kk)",
        "security": [],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ru",
                "kk"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThemeList"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "none"
      }
    },
    "/api/v1/books": {
      "post": {
        "operationId": "bookCreate",
        "tags": [
          "books"
        ],
        "summary": "Новая книга (мастер создания)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedBook"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "user"
      },
      "get": {
        "operationId": "booksList",
        "tags": [
          "books"
        ],
        "summary": "Мои книги с прогрессом",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookList"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "user"
      }
    },
    "/api/v1/books/{bookId}/editor": {
      "get": {
        "operationId": "bookEditor",
        "tags": [
          "books"
        ],
        "summary": "Книга для редактора: главы, вопросы с ответами, фото",
        "parameters": [
          {
            "name": "bookId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookEditor"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "user"
      }
    },
    "/api/v1/books/{bookId}/questions/{questionId}": {
      "patch": {
        "operationId": "questionSave",
        "tags": [
          "books"
        ],
        "summary": "Автосохранение ответа и заголовка раздела (только изменённые поля)",
        "parameters": [
          {
            "name": "bookId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "user"
      }
    },
    "/api/v1/cabinet/shelf": {
      "get": {
        "operationId": "cabinetShelf",
        "tags": [
          "cabinet"
        ],
        "summary": "Полка «Мои книги» — как на сайте: книги в работе первыми, прогресс, срок к празднику, заказ, обложка",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CabinetShelf"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "user"
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "locale": {
            "type": "string",
            "enum": [
              "ru",
              "kk"
            ]
          },
          "isStaff": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "locale",
          "isStaff"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "token",
          "expiresAt",
          "user"
        ],
        "additionalProperties": false
      },
      "LoginResult": {
        "type": "object",
        "properties": {
          "session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Session"
              },
              {
                "type": "null"
              }
            ]
          },
          "secondFactorTicket": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "session",
          "secondFactorTicket"
        ],
        "additionalProperties": false
      },
      "LoginBody": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "login",
          "password"
        ],
        "additionalProperties": false
      },
      "SecondFactorBody": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          },
          "code": {
            "type": "string",
            "minLength": 4,
            "maxLength": 40
          }
        },
        "required": [
          "ticket",
          "code"
        ],
        "additionalProperties": false
      },
      "Theme": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "gift",
              "autobiography",
              "blank"
            ]
          },
          "recipient": {
            "type": "string",
            "enum": [
              "required",
              "optional",
              "none"
            ]
          },
          "name": {
            "type": "string"
          },
          "short": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "recipientLabel": {
            "type": [
              "string",
              "null"
            ]
          },
          "recipientPlaceholder": {
            "type": [
              "string",
              "null"
            ]
          },
          "recipientGender": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "m",
                  "f"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "recipientGenderChoice": {
            "type": "boolean"
          },
          "defaultRecipientGender": {
            "type": "string",
            "enum": [
              "m",
              "f"
            ]
          },
          "titleSuggestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "recipient",
          "name",
          "short",
          "description",
          "emoji",
          "recipientLabel",
          "recipientPlaceholder",
          "recipientGender",
          "recipientGenderChoice",
          "defaultRecipientGender",
          "titleSuggestions"
        ],
        "additionalProperties": false
      },
      "ThemeList": {
        "type": "object",
        "properties": {
          "themes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Theme"
            }
          }
        },
        "required": [
          "themes"
        ],
        "additionalProperties": false
      },
      "CreateBookBody": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string"
          },
          "language": {
            "default": "ru",
            "type": "string",
            "enum": [
              "ru",
              "kk"
            ]
          },
          "authorName": {
            "type": "string",
            "maxLength": 60
          },
          "authorGender": {
            "type": "string",
            "enum": [
              "m",
              "f"
            ]
          },
          "recipientName": {
            "type": "string",
            "maxLength": 60
          },
          "recipientGender": {
            "type": "string",
            "enum": [
              "m",
              "f"
            ]
          },
          "recordedBy": {
            "type": "string"
          },
          "firstChapterTitle": {
            "type": "string"
          },
          "dedication": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "occasion": {
            "type": "string"
          },
          "occasionDate": {
            "type": "string"
          }
        },
        "required": [
          "theme",
          "language",
          "authorName",
          "authorGender"
        ],
        "additionalProperties": false
      },
      "CreatedBook": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "OrderBrief": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "number": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string"
          },
          "printed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "number",
          "status",
          "printed"
        ],
        "additionalProperties": false
      },
      "BookSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "title": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "ordered"
            ]
          },
          "authorName": {
            "type": "string"
          },
          "recipientName": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "answered": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "total": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "words": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "photos": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "coverTemplate": {
            "type": "string"
          },
          "coverPhotoUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrderBrief"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "theme",
          "status",
          "authorName",
          "recipientName",
          "updatedAt",
          "answered",
          "total",
          "words",
          "photos",
          "coverTemplate",
          "coverPhotoUrl",
          "order"
        ],
        "additionalProperties": false
      },
      "BookList": {
        "type": "object",
        "properties": {
          "books": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookSummary"
            }
          }
        },
        "required": [
          "books"
        ],
        "additionalProperties": false
      },
      "AnswerMedia": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "music",
              "audio"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "fileId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "title": {
            "type": "string",
            "maxLength": 180
          },
          "anchor": {
            "anyOf": [
