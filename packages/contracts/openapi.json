{
  "openapi": "3.1.0",
  "info": {
    "title": "MyBooks API",
    "version": "1",
    "description": "Единственный путь к данным для веба и мобильного приложения (ADR 0012). Вход — Authorization: Bearer <token> или cookie mb_session."
  },
  "servers": [
    {
      "url": "https://mybooks.kz"
    }
  ],
  "security": [
    {
      "bearer": []
    },
    {
      "cookie": []
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "authLogin",
        "tags": [
          "auth"
        ],
        "summary": "Вход по почте или телефону и паролю (клиент и сотрудник)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "none"
      }
    },
    "/api/v1/auth/2fa": {
      "post": {
        "operationId": "authSecondFactor",
        "tags": [
          "auth"
        ],
        "summary": "Второй шаг входа сотрудника: код из приложения-аутентификатора",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SecondFactorBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "none"
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "authLogout",
        "tags": [
          "auth"
        ],
        "summary": "Выход: сессия токена закрывается",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "user"
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me",
        "tags": [
          "auth"
        ],
        "summary": "Кто вошёл",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "user"
      }
    },
    "/api/v1/books": {
      "get": {
        "operationId": "booksList",
        "tags": [
          "books"
        ],
        "summary": "Мои книги с прогрессом",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookList"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "user"
      }
    },
    "/api/v1/books/{bookId}/editor": {
      "get": {
        "operationId": "bookEditor",
        "tags": [
          "books"
        ],
        "summary": "Книга для редактора: главы и вопросы с ответами",
        "parameters": [
          {
            "name": "bookId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookEditor"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "user"
      }
    },
    "/api/v1/books/{bookId}/questions/{questionId}": {
      "patch": {
        "operationId": "questionSave",
        "tags": [
          "books"
        ],
        "summary": "Автосохранение ответа и заголовка раздела (только изменённые поля)",
        "parameters": [
          {
            "name": "bookId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка: текст для экрана и код",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-auth": "user"
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "locale": {
            "type": "string",
            "enum": [
              "ru",
              "kk"
            ]
          },
          "isStaff": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "locale",
          "isStaff"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "token",
          "expiresAt",
          "user"
        ],
        "additionalProperties": false
      },
      "LoginResult": {
        "type": "object",
        "properties": {
          "session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Session"
              },
              {
                "type": "null"
              }
            ]
          },
          "secondFactorTicket": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "session",
          "secondFactorTicket"
        ],
        "additionalProperties": false
      },
      "LoginBody": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "login",
          "password"
        ],
        "additionalProperties": false
      },
      "SecondFactorBody": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          },
          "code": {
            "type": "string",
            "minLength": 4,
            "maxLength": 40
          }
        },
        "required": [
          "ticket",
          "code"
        ],
        "additionalProperties": false
      },
      "BookSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "title": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "ordered"
            ]
          },
          "authorName": {
            "type": "string"
          },
          "recipientName": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "answered": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "total": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "words": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "photos": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "title",
          "theme",
          "status",
          "authorName",
          "recipientName",
          "updatedAt",
          "answered",
          "total",
          "words",
          "photos"
        ],
        "additionalProperties": false
      },
      "BookList": {
        "type": "object",
        "properties": {
          "books": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookSummary"
            }
          }
        },
        "required": [
          "books"
        ],
        "additionalProperties": false
      },
      "AnswerMedia": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "music",
              "audio"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "fileId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "title": {
            "type": "string",
            "maxLength": 180
          },
          "anchor": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -1,
                "maximum": 10000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "url",
          "title",
          "anchor"
        ],
        "additionalProperties": false
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "chapter": {
            "type": "string"
          },
          "chapterTitle": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "defaultTitle": {
            "type": "string"
          },
          "displayText": {
            "type": [
              "string",
              "null"
            ]
          },
          "hideHeading": {
            "type": "boolean"
          },
          "answer": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerMedia"
            }
          },
          "isCustom": {
            "type": "boolean"
          },
          "pageBreak": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "chapter",
          "chapterTitle",
          "prompt",
          "hint",
          "defaultTitle",
          "displayText",
          "hideHeading",
          "answer",
          "media",
          "isCustom",
          "pageBreak"
        ],
        "additionalProperties": false
      },
      "Chapter": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "epigraph": {
            "type": "string"
          },
          "own": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "title",
          "epigraph",
          "own"
        ],
        "additionalProperties": false
      },
      "BookEditor": {
        "type": "object",
        "properties": {
          "book": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "title": {
                "type": "string"
              },
              "theme": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "ordered"
                ]
              },
              "language": {
                "type": "string",
                "enum": [
                  "ru",
                  "kk"
                ]
              },
              "kind": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "theme",
              "status",
              "language",
              "kind"
            ],
            "additionalProperties": false
          },
          "editable": {
            "type": "boolean"
          },
          "chapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Chapter"
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Question"
            }
          }
        },
        "required": [
          "book",
          "editable",
          "chapters",
          "questions"
        ],
        "additionalProperties": false
      },
      "QuestionPatch": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 100000
          },
          "displayText": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "hideHeading": {
            "type": "boolean"
          },
          "pageBreak": {
            "type": "boolean"
          },
          "media": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerMedia"
            }
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "prompt": {
            "type": "string",
            "maxLength": 300
          }
        },
        "additionalProperties": false
      },
      "Saved": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "ok",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mb_session"
      }
    }
  }
}
