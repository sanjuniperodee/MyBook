{
  "name": "mybook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-pdf-worker.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --import ./scripts/preload.mjs scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "sample-book": "tsx --import ./scripts/preload.mjs scripts/sample-book.ts",
    "dedupe:deals": "tsx --env-file-if-exists=.env --import ./scripts/preload.mjs scripts/dedupe-deals.ts",
    "photos:layout-rev2": "tsx --env-file-if-exists=.env --import ./scripts/preload.mjs scripts/layout-rev2.ts",
    "scheduler:once": "tsx --env-file-if-exists=.env --import ./scripts/preload.mjs scripts/scheduler-once.ts",
    "test:integration": "INTEGRATION=1 vitest run --no-file-parallelism tests/outbox.integration.test.ts tests/redis.integration.test.ts tests/kaspi.integration.test.ts tests/bot-store.integration.test.ts tests/deal-lifecycle.integration.test.ts tests/automation-scheduled.integration.test.ts tests/automation-stats.integration.test.ts tests/automation-subjects.integration.test.ts tests/automation-runs.integration.test.ts tests/deal-repeat.integration.test.ts tests/clients-filters.integration.test.ts tests/ai-autofill.integration.test.ts tests/attention.integration.test.ts tests/dashboard-new-clients.integration.test.ts tests/promo-stats.integration.test.ts tests/morning-digest.integration.test.ts tests/sales-analytics.integration.test.ts tests/seller-stats.integration.test.ts tests/message-retry.integration.test.ts tests/phone-search.integration.test.ts tests/order-deal.integration.test.ts tests/task-overdue.integration.test.ts tests/marketing-spend.integration.test.ts tests/vcard.integration.test.ts tests/my-day.integration.test.ts tests/notify.integration.test.ts",
    "test:pdf-all": "PDF_CRITICAL=all vitest run tests/pdf-critical.test.ts",
    "visual:check": "bash scripts/visual/check.sh"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "fontkit": "^2.0.4",
    "html-to-image": "^1.11.13",
    "hunspell-asm": "^4.0.2",
    "hyphen": "^1.14.1",
    "imapflow": "^2.1.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.48.0",
    "mailparser": "^3.9.32",
    "next": "^16.3.6",
    "nodemailer": "^10.0.12",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
