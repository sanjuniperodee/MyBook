+// logCallStanza dumps call signaling at debug level (diagnosing relay election and
+// media setup). Stanzas carry relay tokens and keys: debug logging is for diagnosis only.
+func (e *engine) logCallStanza(evt any) {
+	if e.c.log.GetLevel() > zerolog.DebugLevel {
+		return
+	}
+	var kind string
+	var node *waBinary.Node
+	switch ev := evt.(type) {
+	case *events.CallOffer:
+		kind, node = "offer", ev.Data
+	case *events.CallPreAccept:
+		kind, node = "preaccept", ev.Data
+	case *events.CallAccept:
+		kind, node = "accept", ev.Data
+	case *events.CallRelayLatency:
+		kind, node = "relaylatency", ev.Data
+	case *events.CallTransport:
+		kind, node = "transport", ev.Data
+	case *events.CallTerminate:
+		kind, node = "terminate", ev.Data
+	case *events.UnknownCallEvent:
+		kind, node = "unknown", ev.Node
+	default:
+		return
+	}
+	if node == nil {
+		return
+	}
+	xml := node.String()
+	if len(xml) > 8000 {
+		xml = xml[:8000]
+	}
+	e.c.log.Debug().Str("kind", kind).Str("stanza", xml).Msg("call stanza")
+}
