+// micFrame is one whole frame of s16le samples all equal to value.
+func micFrame(value int16) []byte {
+	raw := make([]byte, 0, meowcaller.FrameSamples*2)
+	for i := 0; i < meowcaller.FrameSamples; i++ {
+		raw = binary.LittleEndian.AppendUint16(raw, uint16(value))
+	}
+	return raw
+}
+
+// TestChannelAudioSourceKeepsPartialFrameOnTimeout: a half frame is not padded
+// out and sent cut in two — silence now, the whole frame on the next tick.
+func TestChannelAudioSourceKeepsPartialFrameOnTimeout(t *testing.T) {
+	frames := make(chan []byte, 2)
+	whole := micFrame(100)
+	frames <- whole[:len(whole)/2]
+	source := newChannelAudioSource(frames)
+
+	frame, err := source.ReadFrame()
+	require.NoError(t, err)
+	require.Zero(t, frame[0])
+
+	frames <- whole[len(whole)/2:]
+	frame, err = source.ReadFrame()
+	require.NoError(t, err)
+	require.InDelta(t, float32(100)/32768, frame[0], 0.0001)
+	require.InDelta(t, float32(100)/32768, frame[meowcaller.FrameSamples-1], 0.0001)
+}
+
+// TestChannelAudioSourceNeverStallsTheTick: the send loop ticks every 60 ms, so a
+// quiet microphone must not hold ReadFrame anywhere near that long.
+func TestChannelAudioSourceNeverStallsTheTick(t *testing.T) {
+	source := newChannelAudioSource(make(chan []byte))
+	start := time.Now()
+	_, err := source.ReadFrame()
+	require.NoError(t, err)
+	require.Less(t, time.Since(start), 50*time.Millisecond)
+}
+
+// TestChannelAudioSourceDropsBacklog: after a stall the browser sends a burst;
+// the oldest frames are dropped so the delay goes back to one frame of cushion.
+func TestChannelAudioSourceDropsBacklog(t *testing.T) {
+	frames := make(chan []byte, 32)
+	for i := int16(1); i <= 8; i++ {
+		frames <- micFrame(i * 100)
+	}
+	source := newChannelAudioSource(frames)
+
+	frame, err := source.ReadFrame()
+	require.NoError(t, err)
+	// 8 frames queued: 7 behind the one being read, more than the cap of 4, so
+	// frames 1–6 are dropped, frame 7 is played and frame 8 stays as the cushion.
+	require.InDelta(t, float32(700)/32768, frame[0], 0.0001)
+	frame, err = source.ReadFrame()
+	require.NoError(t, err)
+	require.InDelta(t, float32(800)/32768, frame[0], 0.0001)
+
+	// A small backlog (within the cap) is kept intact.
+	for i := int16(1); i <= 3; i++ {
+		frames <- micFrame(i)
+	}
+	frame, err = source.ReadFrame()
+	require.NoError(t, err)
+	require.InDelta(t, float32(1)/32768, frame[0], 0.0001)
+}
