+// trimBacklog drops the oldest whole frames when more than
+// liveAudioMaxQueuedFrames wait behind the frame about to be read, keeping
+// liveAudioKeepQueuedFrames as a cushion: realtime speech beats a growing delay.
+func (s *channelAudioSource) trimBacklog(frameBytes int) {
+	queued := len(s.pending)/frameBytes - 1
+	if queued <= liveAudioMaxQueuedFrames {
+		return
+	}
+	drop := (queued - liveAudioKeepQueuedFrames) * frameBytes
+	s.pending = append(s.pending[:0], s.pending[drop:]...)
