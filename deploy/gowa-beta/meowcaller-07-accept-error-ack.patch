--- a/engine.go
+++ b/engine.go
@@ -760,6 +760,14 @@ func (e *engine) answer(c *Call) error {
 	return nil
 }
 
+// acceptGoneOut: the inbound call was answered and its <accept> is sent or being sent
+// (Answer sets acceptPending, sendAccept clears it right before transmitting).
+func (e *engine) acceptGoneOut(m *engineCall) bool {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return !m.acceptPending && (m.acceptSent || (m.call != nil && m.call.State() != CallPhaseRinging))
+}
+
 // sendAccept sends the deferred callee <accept> (once), in the WA-Web format (metadata +
 // single rate — the peer keeps the call alive with this; capability+both-rates fails).
 func (e *engine) sendAccept(callID string, to, creator types.JID) {
@@ -1269,6 +1277,16 @@ func (e *engine) onCallAck(ack *waBinary.Node) {
 		if en := findChild(ack, "error"); en != nil {
 			callID = en.AttrGetter().String("call-id")
 		}
+		// An error ack for the <accept> of an inbound call we have already answered is not
+		// the end of the call. Seen live: a Meta-hosted companion of our account
+		// (@hosted.lid) declined the offer first, the server then acks our <accept> with
+		// error 500 — yet the caller did get it (their phone shows the call connected, then
+		// "reconnecting" once we tear media down). Keep the call; <terminate> ends it.
+		if m := e.lookup(callID); m != nil && !m.group && m.direction == CallDirectionIncoming && e.acceptGoneOut(m) {
+			e.c.log.Warn().Str("call_id", callID).Str("error_code", errCode).Str("ack", ack.String()).
+				Msg("server error ack after our accept; keeping the answered call")
+			return
+		}
 		e.c.log.Warn().Str("call_id", callID).Str("error_code", errCode).Msg("call rejected by server")
 		e.finishCall(callID, "server:"+errCode)
 		return
