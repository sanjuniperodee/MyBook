+package whatsapp
+
+import (
+	"testing"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+)
+
+func TestNonceFromBusinessNotification(t *testing.T) {
+	node := &waBinary.Node{Tag: "notification", Attrs: waBinary.Attrs{"type": "business"}, Content: []waBinary.Node{{Tag: "wa_ad_account_nonce", Content: []byte(" 123456 ")}}}
+	if got := NonceFromBusinessNotification(node); got != "123456" {
+		t.Fatalf("nonce: %q", got)
+	}
+	other := &waBinary.Node{Tag: "notification", Content: []waBinary.Node{{Tag: "verified_name"}}}
+	if got := NonceFromBusinessNotification(other); got != "" {
+		t.Fatalf("no nonce expected, got %q", got)
+	}
+}
+
+func TestParseTokenResponse(t *testing.T) {
+	res := &waBinary.Node{Tag: "iq", Content: []waBinary.Node{
+		{Tag: "access_token", Content: []byte("EAAB")},
+		{Tag: "session_cookies", Content: []byte("[]")},
+		{Tag: "business_person", Attrs: waBinary.Attrs{"id": "42"}},
+		{Tag: "token_type", Content: []byte("Strong")},
+	}}
+	tok, err := ParseTokenResponse(res)
+	if err != nil || tok.Token != "EAAB" || tok.BusinessPersonID != "42" || tok.TokenType != "Strong" {
+		t.Fatalf("token: %+v %v", tok, err)
+	}
+	if _, err := ParseTokenResponse(&waBinary.Node{Tag: "iq"}); err == nil {
+		t.Fatal("empty answer must fail")
+	}
+}
+
+func TestGraphQLAuthError(t *testing.T) {
+	if !GraphQLAuthError([]byte(`{"error":{"code":190,"message":"Invalid OAuth access token"}}`)) {
+		t.Fatal("190 is an auth error")
+	}
+	if GraphQLAuthError([]byte(`{"data":{"x":1}}`)) {
+		t.Fatal("data is not an auth error")
+	}
+}
+
+func TestIsWhatsAppImageURL(t *testing.T) {
+	if !IsWhatsAppImageURL("https://mmg.whatsapp.net/v/t45/x.jpg") || IsWhatsAppImageURL("http://mmg.whatsapp.net/x") || IsWhatsAppImageURL("https://evil.com/x.whatsapp.net") {
+		t.Fatal("url check")
+	}
+}
diff --git a/src/ui/rest/catalog.go b/src/ui/rest/catalog.go
new file mode 100644
index 0000000..c4f990b
--- /dev/null
+++ b/src/ui/rest/catalog.go
@@ -0,0 +1,264 @@
+package rest
+
+// WhatsApp Business catalog of the device's own number (see
+// infrastructure/whatsapp/catalog.go): the ad-account token over the socket,
+// GraphQL mutations on graph.facebook.com with it, product photo upload,
+// product cards and the catalog link in chats, cart (order) details.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"strings"
+	"time"
+
+	"github.com/aldinokemal/go-whatsapp-web-multidevice/infrastructure/whatsapp"
+	"github.com/aldinokemal/go-whatsapp-web-multidevice/pkg/utils"
+	"github.com/gofiber/fiber/v3"
+	"go.mau.fi/whatsmeow"
+)
+
+type Catalog struct{}
+
+func InitRestCatalog(app fiber.Router) Catalog {
+	rest := Catalog{}
+	app.Get("/catalog/token", rest.Token)
+	app.Post("/catalog/graphql", rest.GraphQL)
+	app.Post("/catalog/upload-image", rest.UploadImage)
+	app.Post("/catalog/send-product", rest.SendProduct)
+	app.Post("/catalog/send-link", rest.SendCatalogLink)
+	app.Get("/catalog/order", rest.OrderDetails)
+	app.Get("/catalog/image", rest.Image)
+	return rest
+}
+
+func catalogFail(c fiber.Ctx, status int, code, message string) error {
+	return c.Status(status).JSON(fiber.Map{"status": status, "code": code, "message": message})
+}
+
+func catalogOK(c fiber.Ctx, message string, results any) error {
+	return c.JSON(utils.ResponseData{Status: 200, Code: "SUCCESS", Message: message, Results: results})
+}
+
+func catalogClient(c fiber.Ctx) (*whatsmeow.Client, context.Context, context.CancelFunc, error) {
+	ctx := whatsapp.ContextWithDevice(c.Context(), getDeviceFromCtx(c))
+	client := whatsapp.ClientFromContext(ctx)
+	if client == nil || !client.IsConnected() || !client.IsLoggedIn() || client.Store == nil || client.Store.ID == nil {
+		return nil, nil, nil, fiber.NewError(fiber.StatusServiceUnavailable, "WhatsApp is not connected")
+	}
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 3*time.Minute)
+	return client, ctx, cancel, nil
+}
+
+func catalogError(c fiber.Ctx, err error) error {
+	var fe *fiber.Error
+	if errors.As(err, &fe) {
+		return catalogFail(c, fe.Code, "NOT_CONNECTED", fe.Message)
+	}
+	var te *whatsapp.TokenError
+	if errors.As(err, &te) {
+		return catalogFail(c, fiber.StatusBadGateway, "TOKEN_"+strings.ToUpper(strings.ReplaceAll(te.Kind, "-", "_")), err.Error())
+	}
+	var iq *whatsapp.IQError
+	if errors.As(err, &iq) {
+		return catalogFail(c, fiber.StatusBadGateway, "WHATSAPP_ERROR", err.Error())
+	}
+	return catalogFail(c, fiber.StatusBadGateway, "CATALOG_ERROR", err.Error())
+}
+
+// Token checks that WhatsApp gives the catalog token (the token itself stays here).
+func (controller *Catalog) Token(c fiber.Ctx) error {
+	client, ctx, cancel, err := catalogClient(c)
+	if err != nil {
+		return catalogError(c, err)
+	}
+	defer cancel()
+	token, err := whatsapp.AdAccountToken(ctx, client, c.Query("fresh") == "1")
+	if err != nil {
+		return catalogError(c, err)
+	}
+	// The catalog mutations address the business by its LID (WAWebGetFormattedCatalogJid); actor_id is the business person.
+	lid := client.Store.GetLID()
+	return catalogOK(c, "Catalog token is ready", fiber.Map{
+		"business_person_id": token.BusinessPersonID,
+		"token_type":         token.TokenType,
+		"obtained_at":        token.At,
+		"jid":                client.Store.ID.ToNonAD().String(),
+		"lid":                lid.ToNonAD().String(),
+	})
+}
+
+type graphQLRequest struct {
+	DocID     string          `json:"doc_id"`
+	Variables json.RawMessage `json:"variables"`
+	Locale    string          `json:"locale"`
+}
+
+// GraphQL runs a persisted catalog operation on graph.facebook.com with the token.
+func (controller *Catalog) GraphQL(c fiber.Ctx) error {
+	client, ctx, cancel, err := catalogClient(c)
+	if err != nil {
+		return catalogError(c, err)
+	}
+	defer cancel()
+	var req graphQLRequest
+	if err := json.Unmarshal(c.Body(), &req); err != nil || req.DocID == "" || len(req.Variables) == 0 {
+		return catalogFail(c, 400, "INVALID_REQUEST", "doc_id and variables are required")
+	}
+	for _, r := range req.DocID {
+		if r < '0' || r > '9' {
+			return catalogFail(c, 400, "INVALID_REQUEST", "doc_id must be a number")
+		}
+	}
+	body, status, err := whatsapp.FacebookGraphQL(ctx, client, req.DocID, req.Variables, req.Locale)
+	if err != nil {
+		return catalogError(c, err)
+	}
+	if !json.Valid(body) {
+		return catalogOK(c, "GraphQL answer", fiber.Map{"http_status": status, "text": string(body)})
+	}
+	return catalogOK(c, "GraphQL answer", fiber.Map{"http_status": status, "body": json.RawMessage(body)})
+}
+
+// UploadImage uploads product photos (files "image") and returns their URLs.
+func (controller *Catalog) UploadImage(c fiber.Ctx) error {
+	client, ctx, cancel, err := catalogClient(c)
+	if err != nil {
+		return catalogError(c, err)
+	}
+	defer cancel()
+	form, err := c.MultipartForm()
+	if err != nil {
+		return catalogFail(c, 400, "INVALID_REQUEST", "multipart form with image files is required")
+	}
+	urls := []string{}
+	for _, fh := range form.File["image"] {
+		f, err := fh.Open()
+		if err != nil {
+			return catalogError(c, err)
+		}
+		data, err := io.ReadAll(io.LimitReader(f, 8<<20))
+		_ = f.Close()
+		if err != nil {
+			return catalogError(c, err)
+		}
+		u, err := whatsapp.UploadProductImage(ctx, client, data)
+		if err != nil {
+			return catalogError(c, err)
+		}
+		urls = append(urls, u)
+	}
+	if len(urls) == 0 {
+		return catalogFail(c, 400, "INVALID_REQUEST", "no image files")
+	}
+	return catalogOK(c, "Images uploaded", fiber.Map{"urls": urls})
+}
+
+type sendProductRequest struct {
+	Phone   string               `json:"phone"`
+	Product whatsapp.ProductCard `json:"product"`
+}
+
+// SendProduct sends a product card (the customer opens it in WhatsApp).
+func (controller *Catalog) SendProduct(c fiber.Ctx) error {
+	client, ctx, cancel, err := catalogClient(c)
+	if err != nil {
+		return catalogError(c, err)
+	}
+	defer cancel()
+	var req sendProductRequest
+	if err := json.Unmarshal(c.Body(), &req); err != nil || req.Product.ProductID == "" {
+		return catalogFail(c, 400, "INVALID_REQUEST", "phone and product.product_id are required")
+	}
+	utils.SanitizePhone(&req.Phone)
+	recipient, err := utils.ParseJID(req.Phone)
+	if err != nil {
+		return catalogFail(c, 400, "INVALID_JID", err.Error())
+	}
+	var img []byte
+	var mime string
+	if req.Product.ImageURL != "" {
+		img, mime, err = whatsapp.FetchImage(ctx, req.Product.ImageURL)
+		if err != nil {
+			return catalogError(c, err)
+		}
+	}
+	msg, err := whatsapp.BuildProductMessage(ctx, client, req.Product, img, mime)
+	if err != nil {
+		return catalogError(c, err)
+	}
+	resp, err := client.SendMessage(ctx, recipient, msg)
+	if err != nil {
+		return catalogError(c, err)
+	}
+	return catalogOK(c, "Product sent", fiber.Map{"message_id": resp.ID, "status": "sent", "with_image": len(img) > 0})
+}
+
+type sendCatalogLinkRequest struct {
+	Phone       string `json:"phone"`
+	Text        string `json:"text"`
+	Title       string `json:"title"`
+	Description string `json:"description"`
+	ImageURL    string `json:"image_url"`
+}
+
+// SendCatalogLink sends wa.me/c/<own number> with a catalog preview.
+func (controller *Catalog) SendCatalogLink(c fiber.Ctx) error {
+	client, ctx, cancel, err := catalogClient(c)
+	if err != nil {
+		return catalogError(c, err)
+	}
+	defer cancel()
+	var req sendCatalogLinkRequest
+	if err := json.Unmarshal(c.Body(), &req); err != nil {
+		return catalogFail(c, 400, "INVALID_REQUEST", err.Error())
+	}
+	utils.SanitizePhone(&req.Phone)
+	recipient, err := utils.ParseJID(req.Phone)
+	if err != nil {
+		return catalogFail(c, 400, "INVALID_JID", err.Error())
+	}
+	var thumb []byte
+	if req.ImageURL != "" {
+		if data, _, err := whatsapp.FetchImage(ctx, req.ImageURL); err == nil {
+			thumb = whatsapp.CatalogThumbnail(data)
+		}
+	}
+	msg := whatsapp.BuildCatalogLinkMessage(client, req.Text, req.Title, req.Description, thumb)
+	resp, err := client.SendMessage(ctx, recipient, msg)
+	if err != nil {
+		return catalogError(c, err)
+	}
+	return catalogOK(c, "Catalog link sent", fiber.Map{"message_id": resp.ID, "status": "sent", "text": msg.GetExtendedTextMessage().GetText()})
+}
+
+// OrderDetails returns the items of a cart a customer sent (order id and token
+// come from the order message).
+func (controller *Catalog) OrderDetails(c fiber.Ctx) error {
+	client, ctx, cancel, err := catalogClient(c)
+	if err != nil {
+		return catalogError(c, err)
+	}
+	defer cancel()
+	details, err := client.GetOrderDetails(ctx, c.Query("order_id"), c.Query("token"))
+	if err != nil {
+		return catalogError(c, err)
+	}
+	return catalogOK(c, "Success get order", details)
+}
+
+// Image proxies a catalog photo (CRM keeps its own copy for the product list).
+func (controller *Catalog) Image(c fiber.Ctx) error {
+	ctx, cancel := context.WithTimeout(c.Context(), time.Minute)
+	defer cancel()
+	data, mime, err := whatsapp.FetchImage(ctx, c.Query("url"))
+	if err != nil {
+		return catalogFail(c, 400, "IMAGE_ERROR", err.Error())
+	}
+	if mime == "" {
+		mime = "image/jpeg"
+	}
+	c.Set("Content-Type", mime)
+	return c.Send(data)
+}
