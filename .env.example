# ─── Основное ────────────────────────────────────────────────
# Публичный адрес сайта (без слеша в конце). Используется в письмах, ссылках оплаты и SEO.
APP_URL=http://localhost:3000
# Строка подключения к PostgreSQL
DATABASE_URL=postgres://mybook:mybook@localhost:5432/mybook
# Папка для загруженных фото и готовых файлов для типографии
STORAGE_DIR=./storage
# E-mail адреса (через запятую), которым выдаются права администратора после восстановления пароля по ссылке из письма
# (так подтверждается владение адресом). Или создайте админа: npm run create-admin -- email пароль
ADMIN_EMAILS=admin@example.com

# ─── Почта (SMTP). Удобнее настроить в админке: CRM → Интеграции → «Почта для отправки».
# Если задан SMTP_HOST, почта берётся только отсюда (в админке — только просмотр). Без настроек письма пишутся в лог ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="MyBooks <hello@example.com>"
# Куда присылать уведомления о новых заказах
ORDERS_NOTIFY_EMAIL=

# ─── Оплата ──────────────────────────────────────────────────
# manual — оплата переводом (Kaspi и т.п.), подтверждает администратор
# cloudpayments — онлайн-оплата картой через CloudPayments (KZ/RU)
PAYMENT_PROVIDER=manual
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
# Kaspi Pay (счёт в приложение Kaspi по номеру или QR, заказ подтверждается сам) — всё настраивается в CRM → «Интеграции» →
# Kaspi Pay. Нужен сервис kaspi-pos-automation: в docker compose он запускается сам, на сервере с PM2 — bash deploy/sidecars.sh kaspi.
# Необязательно: адрес по умолчанию (в docker compose задан), ключ шифрования сессии (иначе создаётся сам), секрет вебхука.
# KASPI_API_URL=http://127.0.0.1:3010
# KASPI_TOKEN_SECRET_KEY=
# KASPI_WEBHOOK_SECRET=
# Тот же кассир, что у другого проекта на этом сервере (my-test.kz): второй kaspi-pos не ставить, KASPI_API_URL — на
# существующий (там http://127.0.0.1:3032), а сессию кассира взять у него — те же значения, что в его .env. Kaspi держит
# одну сессию на кассира: вход по SMS отсюда вытеснил бы её там, поэтому с этими переменными он в «Интеграциях» отключён.
# В webhooks.json общего kaspi-pos — отдельная запись с адресом этого сайта и своим секретом (KASPI_WEBHOOK_SECRET выше).
# KASPI_TOKEN_SN=
# KASPI_VTOKEN_SECRET=
# KASPI_PROFILE_ID=
# KASPI_ORGANIZATION_ID=

# ─── Производительность ─────────────────────────────────────
# Сколько PDF может генерироваться одновременно (каждая большая книга — до ~1 ГБ памяти)
PDF_CONCURRENCY=1

# ─── Безопасность ────────────────────────────────────────────
# Секрет для подписи ссылок отписки и шифрования ключей интеграций CRM. Любая длинная случайная строка (openssl rand -hex 32).
# Задайте один раз: после смены ключи Wazzup/Zadarma нужно будет ввести в админке заново.
APP_SECRET=

# ─── Фоновые задачи ─────────────────────────────────────────
# Автописьма (советы, напоминания, дедлайны к праздникам) и отложенная отправка сертификатов — каждые 15 минут.
# Правила CRM по времени («клиенту не ответили 15 минут») проверяются раз в минуту.
# off — отключить (например, на тестовом стенде)
SCHEDULER=on

# ─── Интеграции CRM (необязательно) ─────────────────────────
# Обычно настраиваются в админке: CRM → Интеграции. Значения ниже имеют приоритет над админкой.
# WAZZUP_API_KEY=
# WAZZUP_CHANNEL_ID=
# TELEPHONY_PROVIDER=off        # off | zadarma | pbx
# ZADARMA_KEY=
# ZADARMA_SECRET=
# PBX_WEBHOOK_TOKEN=
# ZADARMA_PBX_ID=
# AI-помощник CRM: провайдер и ключи удобнее ввести в «Интеграциях» (Claude, ChatGPT, DeepSeek или свой OpenAI-совместимый API)
# CRM_AI_PROVIDER=anthropic   # anthropic | openai | deepseek | custom
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# Бот-продажник: основная модель — Claude по уровням (Haiku / Sonnet / Opus по сложности сообщения), остальные провайдеры —
# запасные. Обычно настраивается в «Интеграциях» → AI → «Маршрутизация». Подробно: docs/features/bot-llm-routing.md
# AI_SELLER_ROUTING=on          # on | shadow (только наблюдение) | off (как раньше: одна модель продажника)
# AI_MODEL_HAIKU=claude-haiku-5-5
# AI_MODEL_SONNET=claude-sonnet-5-5
# AI_MODEL_OPUS=claude-opus-5-5
# AI_ROUTE_DEFAULT_TIER=haiku   # haiku | sonnet | opus
# AI_ROUTE_SONNET_AT=2          # очков сложности для Sonnet
# AI_ROUTE_OPUS_AT=6            # очков сложности для Opus
# AI_ROUTE_MAX_EXTRA=2          # повышений уровня за одно сообщение клиента (0–4)
# AI_ROUTE_BUDGET_USD=0.5       # потолок расходов на беседу, $ (0 — без потолка)
# AI_ROUTE_DAILY_BUDGET_USD=    # потолок расходов в сутки, $
# AI_ROUTE_PRICES=              # прайс, $ за 1M токенов: {"claude-haiku-5-5":{"input":0.1,"output":0.5,"cacheRead":0.01,"cacheWrite":0.2}}
# AI_SELLER_FALLBACKS=          # запасные провайдеры по порядку: deepseek,openai (пусто — прежний провайдер продажника)
# AI_ROUTE_SONNET_ENABLED=on    # off — Sonnet не вызывается (экономия токенов): ход на Haiku
# AI_ROUTE_OPUS_ENABLED=on      # off — Opus не вызывается: ход на Sonnet
# AI_ROUTE_EFFORT_HAIKU=medium  # глубина рассуждения уровня: medium | low (дешевле, но обмен качества на цену)
# AI_ROUTE_EFFORT_SONNET=medium
# AI_ROUTE_EFFORT_OPUS=medium
# AI_ROUTE_CACHE_TTL_HAIKU=1h   # срок кэша инструкции уровня: 1h | 5m (дешевле запись, если уровень вызывается редко)
# AI_ROUTE_CACHE_TTL_SONNET=1h
# AI_ROUTE_CACHE_TTL_OPUS=1h
# AI_ROUTE_REWRITE=same         # ответ не прошёл проверку: same — сначала тот же уровень, потом выше; up — сразу выше
# Вложения клиента (docs/features/bot-media.md): фото, скриншоты и PDF — Claude Vision или модель «Голосовые и фото»
# MEDIA_VISION=claude           # claude | media
# MEDIA_VISION_MODEL=           # модель Claude для фото и PDF (пусто — Haiku маршрута)
# CHAT_MEDIA_HOSTS=             # доп. хосты, с которых сервер скачивает вложения по ссылке канала (к Wazzup), через запятую
# Режим AI в чате (docs/features/bot-chat-control.md)
# BOT_HUMAN_HOLD=on             # менеджер написал — днём бот молчит в чате до «Возобновить AI» (off — прежний подхват)
# BOT_HUMAN_NIGHT=on            # ночью бот отвечает и в таких чатах
# WhatsApp через свой шлюз GOWA (go-whatsapp-web-multidevice) вместо Wazzup — всё настраивается в «Интеграциях»: адрес шлюза,
# логин:пароль, привязка номера по QR; вебхук сайт заводит в шлюзе сам. В docker compose шлюз запускается сам, на сервере
# с PM2 — bash deploy/sidecars.sh whatsapp. Переменные ниже — только значения по умолчанию, админка может их изменить.
# WHATSAPP_PROVIDER=wazzup      # wazzup | gowa
# GOWA_API_URL=http://127.0.0.1:3020
# GOWA_BASIC_AUTH=admin:длинный-пароль       # логин:пароль API шлюза (APP_BASIC_AUTH)
# GOWA_CALLBACK_URL=                          # куда шлюз шлёт входящие; пусто — APP_URL/api/integrations/gowa
# Почта как канал CRM: входящий ящик (IMAP) и адрес для ответов
# CRM_IMAP_HOST=
# CRM_IMAP_PORT=993
# CRM_IMAP_USER=
# CRM_IMAP_PASSWORD=
# CRM_REPLY_TO=

# ─── Аналитика (необязательно) ──────────────────────────────
# Счётчики подключаются, только если указан ID. Задайте до сборки (npm run build).
# Цели: sign_up, book_created, begin_checkout, order_created, purchase, gift_checkout, gift_purchase
YANDEX_METRIKA_ID=
GA_MEASUREMENT_ID=
META_PIXEL_ID=

# ─── Поисковики (необязательно) ─────────────────────────────
# Коды подтверждения сайта: Google Search Console → «Метатег HTML», Яндекс Вебмастер → «Метатег».
# Нужно только значение content="…". После этого отправьте адрес APP_URL/sitemap.xml в оба сервиса.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# ─── Масштабирование (необязательно) ────────────────────────
# Redis нужен только при нескольких экземплярах приложения: лимиты частоты и защита кодов 2FA
# становятся общими. На одном процессе (PM2 fork, один контейнер) не нужен.
# REDIS_URL=redis://localhost:6379
