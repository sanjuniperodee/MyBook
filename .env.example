# ─── Основное ────────────────────────────────────────────────
# Публичный адрес сайта (без слеша в конце). Используется в письмах, ссылках оплаты и SEO.
APP_URL=http://localhost:3000
# Строка подключения к PostgreSQL
DATABASE_URL=postgres://mybook:mybook@localhost:5432/mybook
# Папка для загруженных фото и готовых файлов для типографии
STORAGE_DIR=./storage
# E-mail адреса (через запятую), которым выдаются права администратора после восстановления пароля по ссылке из письма
# (так подтверждается владение адресом). Или создайте админа: npm run create-admin -- email пароль
ADMIN_EMAILS=admin@example.com

# ─── Почта (SMTP). Если не заполнено — письма пишутся в лог сервера ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="MyBooks <hello@example.com>"
# Куда присылать уведомления о новых заказах
ORDERS_NOTIFY_EMAIL=

# ─── Оплата ──────────────────────────────────────────────────
# manual — оплата переводом (Kaspi и т.п.), подтверждает администратор
# cloudpayments — онлайн-оплата картой через CloudPayments (KZ/RU)
PAYMENT_PROVIDER=manual
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# ─── Производительность ─────────────────────────────────────
# Сколько PDF может генерироваться одновременно (каждая большая книга — до ~1 ГБ памяти)
PDF_CONCURRENCY=2

# ─── Безопасность ────────────────────────────────────────────
# Секрет для подписи ссылок отписки и шифрования ключей интеграций CRM. Любая длинная случайная строка (openssl rand -hex 32).
# Задайте один раз: после смены ключи Wazzup/Zadarma нужно будет ввести в админке заново.
APP_SECRET=

# ─── Фоновые задачи ─────────────────────────────────────────
# Автописьма (советы, напоминания, дедлайны к праздникам) и отложенная отправка сертификатов — каждые 15 минут.
# Правила CRM по времени («клиенту не ответили 15 минут») проверяются раз в минуту.
# off — отключить (например, на тестовом стенде)
SCHEDULER=on

# ─── Интеграции CRM (необязательно) ─────────────────────────
# Обычно настраиваются в админке: CRM → Интеграции. Значения ниже имеют приоритет над админкой.
# WAZZUP_API_KEY=
# WAZZUP_CHANNEL_ID=
# TELEPHONY_PROVIDER=off        # off | zadarma | pbx
# ZADARMA_KEY=
# ZADARMA_SECRET=
# PBX_WEBHOOK_TOKEN=
# ZADARMA_PBX_ID=
# AI-помощник CRM (Claude API) — можно ввести и в «Интеграциях»
# ANTHROPIC_API_KEY=
# Почта как канал CRM: входящий ящик (IMAP) и адрес для ответов
# CRM_IMAP_HOST=
# CRM_IMAP_PORT=993
# CRM_IMAP_USER=
# CRM_IMAP_PASSWORD=
# CRM_REPLY_TO=

# ─── Аналитика (необязательно) ──────────────────────────────
# Счётчики подключаются, только если указан ID. Задайте до сборки (npm run build).
# Цели: sign_up, book_created, begin_checkout, order_created, purchase, gift_checkout, gift_purchase
YANDEX_METRIKA_ID=
GA_MEASUREMENT_ID=
META_PIXEL_ID=
